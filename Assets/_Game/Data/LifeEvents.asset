  m_Name: LifeEvents
  m_EditorClassIdentifier: Assembly-CSharp::IanGame.LifeEventCatalog
  events:
  - title: "\uC228 \uC26C\uAE30 \uAD6C\uB3C5"
    description: "\uBB34\uB8CC \uCCB4\uD5D8\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uACF5\uAE30\uB294 \uC544\uC9C1 \uBB34\uB8CC\uC785\uB2C8\uB2E4."
    weight: 1
    happiness: 0
    stress: 5
    energy: 0
    money: -6
  - title: "\uCE6D\uCC2C \uC801\uB9BD"
    description: "\uD300\uC7A5\uC774 \uCE6D\uCC2C\uD588\uC2B5\uB2C8\uB2E4. \uAE09\uC5EC \uB300\uC2E0\uC785\uB2C8\uB2E4."
    weight: 1
    happiness: 5
    stress: 7
    energy: 0
    money: 0
  - title: "\uAE38\uC5D0\uC11C \uC8FC\uC6B4 \uD589\uC6B4"
    description: "\uB3D9\uC804\uC744 \uC8FC\uC6E0\uC2B5\uB2C8\uB2E4. \uD589\uBCF5 \uAD6C\uB9E4\uC5D0\uB294 \uC870\uAE08 \uBD80\uC871\uD569\uB2C8\uB2E4."
    weight: 1
    happiness: 4
    stress: 0
    energy: 0
    money: 8
  - title: "\uAC15\uC81C \uD734\uC2DD"
    description: "\uBAB8\uC774 \uD30C\uC5C5\uD588\uC2B5\uB2C8\uB2E4. \uB178\uC870\uB294 \uC5C6\uC9C0\uB9CC \uD611\uC0C1\uC740 \uD569\uB2C8\uB2E4."
    weight: 1
    happiness: 0
    stress: 0
    energy: 12
    money: -5
  - title: "\uC54C\uACE0\uB9AC\uC998\uC758 \uC704\uB85C"
    description: "\uB2F9\uC2E0\uBCF4\uB2E4 \uD798\uB4E0 \uC0AC\uB78C \uC601\uC0C1\uC744 \uCD94\uCC9C\uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    weight: 1
    happiness: -5
    stress: 8
    energy: 0
    money: 0
  - title: "\uC6D4\uAE09 \uC624\uB958"
    description: "\uC815\uC0B0 \uC624\uB958\uB85C \uB3C8\uC774 \uB354 \uB4E4\uC5B4\uC654\uC2B5\uB2C8\uB2E4. \uC591\uC2EC\uC740 \uB2E4\uC74C \uB2EC\uC5D0 \uCD9C\uADFC\uD569\uB2C8\uB2E4."
    weight: 0.7
    happiness: 0
    stress: 3
    energy: 0
    money: 15
  - title: "\uD589\uBCF5 \uC5C5\uB370\uC774\uD2B8"
    description: "\uD589\uBCF5 \uC571\uC774 \uC5C5\uB370\uC774\uD2B8\uB410\uC2B5\uB2C8\uB2E4. \uAE30\uBD84\uC740 \uC774\uC804 \uBC84\uC804\uC774 \uB0AB\uC2B5\uB2C8\uB2E4."
    weight: 1.1
    happiness: -6
    stress: 4
    energy: 0
    money: -3
  - title: "\uBB34\uB8CC \uC0C1\uB2F4"
    description: "\uC0C1\uB2F4\uC740 \uBB34\uB8CC\uC600\uC2B5\uB2C8\uB2E4. \uB2E4\uC74C \uD68C\uCC28\uBD80\uD130 \uB9C8\uC74C\uC744 \uD560\uBD80\uB85C \uBC1B\uC2B5\uB2C8\uB2E4."
    weight: 1
    happiness: 7
    stress: -10
    energy: 0
    money: 0
  - title: "\uC0AC\uD68C\uC801 \uBC30\uD130\uB9AC"
    description: "\uBAA8\uC784\uC774 \uCDE8\uC18C\uB410\uC2B5\uB2C8\uB2E4. \uC774\uC548\uC740 \uCC98\uC74C\uC73C\uB85C \uC77C\uC815 \uAD00\uB9AC\uC5D0 \uAC10\uC0AC\uD588\uC2B5\uB2C8\uB2E4."
    weight: 1.2
    happiness: 4
    stress: -8
    energy: 14
    money: 0
  - title: "\uAD6C\uB3C5 \uAC31\uC2E0"
    description: "\uD574\uC9C0 \uBC84\uD2BC\uC744 \uCC3E\uB294 \uB3D9\uC548 \uD55C \uB2EC\uC774 \uAC31\uC2E0\uB410\uC2B5\uB2C8\uB2E4."
    weight: 1.2
    happiness: 0
    stress: 8
    energy: 0
    money: -9
  - title: "\uD0DD\uBC30\uC758 \uC704\uB85C"
    description: "\uC8FC\uBB38\uD55C \uC801 \uC5C6\uB294 \uC120\uBB3C\uC774 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4. \uBCF4\uB0B8 \uC0AC\uB78C\uB3C4 \uC774\uC548\uC785\uB2C8\uB2E4."
    weight: 0.8
    happiness: 10
    stress: 0
    energy: 0
    money: -7
  - title: "\uAC74\uAC15 \uAC80\uC9C4"
    description: "\uC758\uC0AC\uB294 \uC26C\uB77C\uACE0 \uD588\uC2B5\uB2C8\uB2E4. \uD68C\uC0AC\uB294 \uC758\uC0AC \uC758\uACAC\uC744 \uAC80\uD1A0 \uC911\uC785\uB2C8\uB2E4."
    weight: 1
    happiness: 0
    stress: 6
    energy: -8
    money: -5
